/*=========================================================
    PERSONAL EXPENSE TRACKER
    Modern Fintech UI
    Part 1
=========================================================*/

/* Google Font */
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

/*=========================================================
    CSS VARIABLES
=========================================================*/

:root{

    --primary:#2563eb;
    --primary-dark:#1d4ed8;
    --secondary:#4f46e5;

    --success:#22c55e;
    --danger:#ef4444;
    --warning:#f59e0b;
    --info:#06b6d4;

    --background:#f5f7fb;
    --surface:#ffffff;
    --surface-light:rgba(255,255,255,.75);

    --text:#1e293b;
    --text-light:#64748b;

    --border:#e2e8f0;

    --radius-sm:12px;
    --radius:18px;
    --radius-lg:24px;

    --shadow-sm:0 8px 20px rgba(15,23,42,.05);
    --shadow:0 15px 35px rgba(15,23,42,.08);
    --shadow-lg:0 20px 45px rgba(15,23,42,.12);

    --transition:.35s ease;
}

/*=========================================================
    RESET
=========================================================*/

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{

    font-family:'Poppins',sans-serif;

    background:linear-gradient(
    180deg,
    #f8fbff 0%,
    #eef4ff 100%);

    color:var(--text);

    overflow-x:hidden;

}

/*=========================================================
    TYPOGRAPHY
=========================================================*/

h1,h2,h3,h4,h5,h6{

    font-weight:700;

    color:var(--text);

}

p{

    color:var(--text-light);

    line-height:1.7;

}

a{

    text-decoration:none;

    transition:var(--transition);

}

img{

    max-width:100%;

}

/*=========================================================
    CUSTOM SCROLLBAR
=========================================================*/

::-webkit-scrollbar{

    width:9px;

}

::-webkit-scrollbar-track{

    background:#edf2f7;

}

::-webkit-scrollbar-thumb{

    background:linear-gradient(
    180deg,
    var(--primary),
    var(--secondary));

    border-radius:50px;

}

::-webkit-scrollbar-thumb:hover{

    background:var(--primary-dark);

}

/*=========================================================
    NAVBAR
=========================================================*/

.custom-navbar{

    position:sticky;

    top:0;

    z-index:999;

    backdrop-filter:blur(18px);

    background:rgba(37,99,235,.90);

    border-bottom:1px solid rgba(255,255,255,.15);

    box-shadow:var(--shadow);

    padding:15px 30px;

}

.logo-box{

    height:54px;

    width:54px;

    border-radius:18px;

    display:flex;

    justify-content:center;

    align-items:center;

    font-size:26px;

    background:white;

    color:var(--primary);

    font-weight:700;

    box-shadow:0 10px 25px rgba(0,0,0,.15);

}

.brand-title{

    color:white;

    font-size:22px;

    font-weight:700;

}

.brand-subtitle{

    color:#dbeafe;

    font-size:12px;

    letter-spacing:1px;

}

.search-box{

    max-width:420px;

    width:100%;

}

.search-box .input-group{

    border-radius:18px;

    overflow:hidden;

    box-shadow:0 8px 20px rgba(0,0,0,.10);

}

.search-box .input-group-text{

    background:white;

    border:none;

}

.search-box input{

    border:none;

    background:white;

    height:48px;

}

.search-box input:focus{

    box-shadow:none;

}

.nav-link{

    color:white!important;

    font-weight:500;

    margin-left:10px;

    position:relative;

}

.nav-link:hover{

    color:#ffe082!important;

}

.notification-icon{

    position:relative;

}

.notification-icon .badge{

    position:absolute;

    top:-6px;

    right:-8px;

    font-size:10px;

    border-radius:50px;

    padding:5px 7px;

}

/*=========================================================
    PROFILE
=========================================================*/

.profile-img{

    width:46px;

    height:46px;

    border-radius:50%;

    object-fit:cover;

    border:3px solid white;

    cursor:pointer;

    transition:var(--transition);

}

.profile-img:hover{

    transform:scale(1.08);

}

/*=========================================================
    SIDEBAR
=========================================================*/

.sidebar{

    position:fixed;

    top:0;

    left:0;

    width:280px;

    height:100vh;

    background:linear-gradient(
    180deg,
    #1e293b,
    #0f172a);

    color:white;

    display:flex;

    flex-direction:column;

    justify-content:space-between;

    box-shadow:8px 0 35px rgba(0,0,0,.15);

    z-index:1000;

}

.sidebar-header{

    padding:35px 20px;

    text-align:center;

}

.logo-circle{

    width:78px;

    height:78px;

    border-radius:50%;

    margin:auto;

    display:flex;

    justify-content:center;

    align-items:center;

    background:linear-gradient(
    135deg,
    var(--primary),
    var(--secondary));

    font-size:34px;

    color:white;

    box-shadow:0 15px 35px rgba(37,99,235,.45);

}

.sidebar-header h5{

    margin-top:18px;

    color:white;

    font-weight:700;

}

.sidebar-header small{

    color:#94a3b8;

}

.sidebar-menu{

    list-style:none;

    padding:15px;

}

.sidebar-menu li{

    margin-bottom:10px;

}

.sidebar-menu a{

    display:flex;

    align-items:center;

    gap:15px;

    padding:15px 18px;

    color:#cbd5e1;

    border-radius:16px;

    transition:var(--transition);

    font-weight:500;

}

.sidebar-menu a i{

    font-size:20px;

    width:26px;

}

.sidebar-menu a:hover{

    background:linear-gradient(
    135deg,
    var(--primary),
    var(--secondary));

    color:white;

    transform:translateX(6px);

    box-shadow:0 12px 25px rgba(37,99,235,.25);

}

.sidebar-menu a.active{

    background:linear-gradient(
    135deg,
    var(--primary),
    var(--secondary));

    color:white;

    box-shadow:0 12px 25px rgba(37,99,235,.35);

}

.sidebar-footer{

    padding:20px;

}

.sidebar-footer a{

    display:flex;

    justify-content:center;

    align-items:center;

    gap:10px;

    padding:15px;

    border-radius:16px;

    background:#ef4444;

    color:white;

    font-weight:600;

}

.sidebar-footer a:hover{

    background:#dc2626;

    transform:translateY(-3px);

}

/*=========================================================
    MAIN CONTENT
=========================================================*/

.main-content{

    margin-left:280px;

    padding:35px;

    min-height:100vh;

}

.page-title{

    font-size:32px;

    font-weight:700;

    margin-bottom:30px;

}

/*=========================================================
    GLASS CARD
=========================================================*/

.glass-card{

    background:rgba(255,255,255,.80);

    backdrop-filter:blur(15px);

    border:1px solid rgba(255,255,255,.35);

    border-radius:22px;

    box-shadow:var(--shadow);

}
/*=========================================================
    DASHBOARD STATISTIC CARDS
=========================================================*/

.stats-card{

    position:relative;

    overflow:hidden;

    background:#fff;

    border-radius:22px;

    padding:28px;

    box-shadow:var(--shadow);

    transition:var(--transition);

    border:1px solid rgba(255,255,255,.6);

}

.stats-card:hover{

    transform:translateY(-8px);

    box-shadow:var(--shadow-lg);

}

.stats-card::before{

    content:"";

    position:absolute;

    top:0;

    left:0;

    width:100%;

    height:6px;

}

.stats-card.primary::before{

    background:linear-gradient(90deg,#2563eb,#4f46e5);

}

.stats-card.success::before{

    background:linear-gradient(90deg,#22c55e,#16a34a);

}

.stats-card.danger::before{

    background:linear-gradient(90deg,#ef4444,#dc2626);

}

.stats-card.warning::before{

    background:linear-gradient(90deg,#f59e0b,#f97316);

}

.stats-card .icon{

    width:72px;

    height:72px;

    border-radius:20px;

    display:flex;

    align-items:center;

    justify-content:center;

    font-size:32px;

    color:#fff;

    margin-bottom:20px;

}

.stats-card.primary .icon{

    background:linear-gradient(135deg,#2563eb,#4f46e5);

}

.stats-card.success .icon{

    background:linear-gradient(135deg,#22c55e,#16a34a);

}

.stats-card.danger .icon{

    background:linear-gradient(135deg,#ef4444,#dc2626);

}

.stats-card.warning .icon{

    background:linear-gradient(135deg,#f59e0b,#f97316);

}

.stats-card h6{

    color:var(--text-light);

    font-size:14px;

    text-transform:uppercase;

    letter-spacing:1px;

}

.stats-card h2{

    font-size:36px;

    font-weight:700;

    margin-top:12px;

    margin-bottom:10px;

}

.stats-card small{

    color:var(--success);

    font-weight:600;

}

/*=========================================================
    COMMON CARDS
=========================================================*/

.card{

    border:none;

    border-radius:22px;

    overflow:hidden;

    background:#fff;

    box-shadow:var(--shadow);

    transition:var(--transition);

}

.card:hover{

    transform:translateY(-5px);

}

.card-header{

    border:none;

    padding:20px 25px;

    font-weight:700;

    background:linear-gradient(135deg,#2563eb,#4f46e5);

    color:#fff;

}

.card-body{

    padding:25px;

}

/*=========================================================
    BUTTONS
=========================================================*/

.btn{

    border-radius:14px;

    padding:12px 24px;

    font-weight:600;

    transition:all .35s ease;

    border:none;

}

.btn:hover{

    transform:translateY(-3px);

}

.btn-primary{

    background:linear-gradient(135deg,#2563eb,#4f46e5);

    color:#fff;

}

.btn-primary:hover{

    box-shadow:0 12px 30px rgba(37,99,235,.35);

}

.btn-success{

    background:linear-gradient(135deg,#22c55e,#16a34a);

}

.btn-success:hover{

    box-shadow:0 12px 30px rgba(34,197,94,.35);

}

.btn-danger{

    background:linear-gradient(135deg,#ef4444,#dc2626);

}

.btn-danger:hover{

    box-shadow:0 12px 30px rgba(239,68,68,.35);

}

.btn-warning{

    background:linear-gradient(135deg,#f59e0b,#f97316);

    color:#fff;

}

.btn-secondary{

    background:#64748b;

    color:#fff;

}

.btn-outline-primary{

    border:2px solid var(--primary);

    color:var(--primary);

    background:#fff;

}

.btn-outline-primary:hover{

    background:var(--primary);

    color:#fff;

}

/*=========================================================
    FORMS
=========================================================*/

.form-control,
.form-select{

    height:52px;

    border-radius:14px;

    border:1px solid #dbe3ef;

    padding-left:18px;

    font-size:15px;

    transition:all .3s ease;

    background:#fff;

}

.form-control:focus,
.form-select:focus{

    border-color:var(--primary);

    box-shadow:0 0 0 .25rem rgba(37,99,235,.15);

}

textarea.form-control{

    min-height:140px;

    padding-top:15px;

}

label{

    font-weight:600;

    margin-bottom:8px;

    color:var(--text);

}

/*=========================================================
    INPUT GROUP
=========================================================*/

.input-group{

    border-radius:14px;

    overflow:hidden;

}

.input-group-text{

    background:#f8fafc;

    border:1px solid #dbe3ef;

    color:var(--primary);

}

/*=========================================================
    FLOATING LABELS
=========================================================*/

.form-floating>.form-control{

    height:58px;

}

.form-floating>label{

    padding:1rem;

}

/*=========================================================
    BADGES
=========================================================*/

.badge{

    padding:8px 14px;

    border-radius:50px;

    font-size:12px;

    font-weight:600;

}

.badge-success{

    background:#dcfce7;

    color:#15803d;

}

.badge-danger{

    background:#fee2e2;

    color:#b91c1c;

}

.badge-warning{

    background:#fef3c7;

    color:#b45309;

}

/*=========================================================
    ALERTS
=========================================================*/

.alert{

    border:none;

    border-radius:18px;

    padding:18px 22px;

    font-weight:500;

    box-shadow:var(--shadow-sm);

}

/*=========================================================
    QUICK ACTION CARDS
=========================================================*/

.quick-card{

    background:#fff;

    border-radius:20px;

    padding:25px;

    text-align:center;

    transition:var(--transition);

    box-shadow:var(--shadow-sm);

}

.quick-card:hover{

    transform:translateY(-8px);

    box-shadow:var(--shadow);

}

.quick-card i{

    font-size:42px;

    margin-bottom:15px;

    color:var(--primary);

}

.quick-card h5{

    margin-bottom:10px;

}

/*=========================================================
    PROGRESS BAR
=========================================================*/

.progress{

    height:12px;

    border-radius:50px;

    background:#e2e8f0;

}

.progress-bar{

    border-radius:50px;

    background:linear-gradient(90deg,#2563eb,#4f46e5);

}

/*=========================================================
    SMALL ANIMATIONS
=========================================================*/

.fade-up{

    animation:fadeUp .6s ease forwards;

}

@keyframes fadeUp{

    from{

        opacity:0;

        transform:translateY(20px);

    }

    to{

        opacity:1;

        transform:translateY(0);

    }

}

.scale-hover{

    transition:.35s;

}

.scale-hover:hover{

    transform:scale(1.03);

