/*=========================================================
    TABLES
=========================================================*/

.table-container{

    background:#fff;

    border-radius:22px;

    padding:25px;

    box-shadow:var(--shadow);

    overflow:hidden;

}

.table{

    margin-bottom:0;

    border-collapse:separate;

    border-spacing:0 12px;

}

.table thead th{

    background:#f8fafc;

    color:var(--text);

    border:none;

    padding:18px;

    font-size:14px;

    font-weight:700;

    text-transform:uppercase;

    letter-spacing:.5px;

}

.table tbody tr{

    background:#fff;

    transition:.3s;

    box-shadow:0 3px 12px rgba(0,0,0,.04);

}

.table tbody tr:hover{

    transform:scale(1.01);

    box-shadow:0 8px 24px rgba(37,99,235,.08);

}

.table tbody td{

    border:none;

    padding:18px;

    vertical-align:middle;

}

/*=========================================================
    SEARCH BAR
=========================================================*/

.search-card{

    background:#fff;

    padding:20px;

    border-radius:20px;

    box-shadow:var(--shadow-sm);

    margin-bottom:25px;

}

.search-card .form-control{

    border-radius:50px;

    padding-left:22px;

}

/*=========================================================
    FILTER DROPDOWN
=========================================================*/

.filter-select{

    min-width:180px;

    border-radius:50px;

}

/*=========================================================
    PAGINATION
=========================================================*/

.pagination{

    gap:10px;

}

.page-link{

    border:none;

    border-radius:12px;

    color:var(--primary);

    padding:10px 16px;

    box-shadow:var(--shadow-sm);

}

.page-item.active .page-link{

    background:linear-gradient(135deg,#2563eb,#4f46e5);

    color:#fff;

}

/*=========================================================
    REPORT SUMMARY
=========================================================*/

.report-summary{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(240px,1fr));

    gap:20px;

    margin-bottom:30px;

}

.report-card{

    background:#fff;

    border-radius:20px;

    padding:25px;

    box-shadow:var(--shadow);

    transition:.3s;

}

.report-card:hover{

    transform:translateY(-6px);

}

.report-card h6{

    color:var(--text-light);

    margin-bottom:12px;

}

.report-card h2{

    font-size:32px;

    font-weight:700;

}

/*=========================================================
    CHARTS
=========================================================*/

.chart-card{

    background:#fff;

    border-radius:22px;

    padding:25px;

    box-shadow:var(--shadow);

    margin-bottom:25px;

}

.chart-card canvas{

    width:100%!important;

    height:360px!important;

}

/*=========================================================
    REPORT FILTER
=========================================================*/

.report-filter{

    background:#fff;

    border-radius:20px;

    padding:20px;

    margin-bottom:30px;

    box-shadow:var(--shadow-sm);

}

/*=========================================================
    PROFILE PAGE
=========================================================*/

.profile-card{

    background:#fff;

    border-radius:24px;

    text-align:center;

    padding:35px;

    box-shadow:var(--shadow);

}

.profile-avatar{

    width:120px;

    height:120px;

    border-radius:50%;

    object-fit:cover;

    border:5px solid #fff;

    box-shadow:0 12px 30px rgba(37,99,235,.25);

    margin-bottom:20px;

}

.profile-card h4{

    margin-bottom:6px;

}

.profile-card p{

    color:var(--text-light);

}

.profile-stats{

    display:flex;

    justify-content:space-around;

    margin-top:30px;

}

.profile-stats h3{

    margin-bottom:4px;

}

.profile-stats span{

    color:var(--text-light);

    font-size:14px;

}

/*=========================================================
    SETTINGS PAGE
=========================================================*/

.settings-card{

    background:#fff;

    border-radius:22px;

    padding:28px;

    box-shadow:var(--shadow);

    margin-bottom:25px;

}

.settings-card h5{

    margin-bottom:20px;

}

.setting-item{

    display:flex;

    justify-content:space-between;

    align-items:center;

    padding:18px 0;

    border-bottom:1px solid #edf2f7;

}

.setting-item:last-child{

    border-bottom:none;

}

/*=========================================================
    SWITCH
=========================================================*/

.form-switch .form-check-input{

    width:60px;

    height:30px;

    cursor:pointer;

}

.form-switch .form-check-input:checked{

    background-color:var(--primary);

    border-color:var(--primary);

}

/*=========================================================
    EMPTY STATE
=========================================================*/

.empty-state{

    text-align:center;

    padding:60px 20px;

}

.empty-state i{

    font-size:70px;

    color:#cbd5e1;

    margin-bottom:20px;

}

.empty-state h4{

    margin-bottom:10px;

}

.empty-state p{

    color:var(--text-light);

}

/*=========================================================
    LOADER
=========================================================*/

.loader{

    width:45px;

    height:45px;

    border:4px solid #e2e8f0;

    border-top-color:var(--primary);

    border-radius:50%;

    animation:spin .8s linear infinite;

    margin:auto;

}

@keyframes spin{

    to{

        transform:rotate(360deg);

    }

}
/*=========================================================
    FOOTER
=========================================================*/

.footer{

    margin-top:40px;

    background:linear-gradient(135deg,#2563eb,#4f46e5);

    color:#fff;

    padding:35px;

    border-radius:24px 24px 0 0;

    box-shadow:0 -10px 30px rgba(37,99,235,.20);

}

.footer h5{

    font-weight:700;

    margin-bottom:15px;

}

.footer p{

    color:rgba(255,255,255,.85);

}

.footer a{

    color:#fff;

    transition:.3s;

}

.footer a:hover{

    color:#ffd43b;

}

.footer hr{

    border-color:rgba(255,255,255,.20);

}

.footer-social{

    display:flex;

    gap:15px;

}

.footer-social a{

    width:42px;

    height:42px;

    display:flex;

    justify-content:center;

    align-items:center;

    border-radius:50%;

    background:rgba(255,255,255,.12);

    transition:.3s;

}

.footer-social a:hover{

    background:#fff;

    color:var(--primary);

    transform:translateY(-4px);

}

/*=========================================================
    MODALS
=========================================================*/

.modal-content{

    border:none;

    border-radius:22px;

    box-shadow:var(--shadow-lg);

}

.modal-header{

    border-bottom:1px solid #edf2f7;

    padding:20px 25px;

}

.modal-footer{

    border-top:1px solid #edf2f7;

}

/*=========================================================
    TOAST
=========================================================*/

.toast{

    border:none;

    border-radius:18px;

    box-shadow:var(--shadow);

}

/*=========================================================
    DROPDOWN
=========================================================*/

.dropdown-menu{

    border:none;

    border-radius:18px;

    box-shadow:var(--shadow);

    padding:10px;

}

.dropdown-item{

    border-radius:12px;

    padding:12px 16px;

    transition:.3s;

}

.dropdown-item:hover{

    background:#eef4ff;

    color:var(--primary);

}

/*=========================================================
    LOGIN PAGE
=========================================================*/

.login-page{

    min-height:100vh;

    display:flex;

    justify-content:center;

    align-items:center;

    background:linear-gradient(135deg,#2563eb,#4f46e5);

}

.login-card{

    width:100%;

    max-width:430px;

    background:#fff;

    padding:40px;

    border-radius:28px;

    box-shadow:0 30px 60px rgba(0,0,0,.20);

}

.login-logo{

    width:90px;

    height:90px;

    border-radius:50%;

    margin:auto;

    display:flex;

    justify-content:center;

    align-items:center;

    font-size:42px;

    color:#fff;

    background:linear-gradient(135deg,#2563eb,#4f46e5);

    margin-bottom:25px;

}

.login-card h2{

    text-align:center;

    margin-bottom:10px;

}

.login-card p{

    text-align:center;

    margin-bottom:30px;

}

/*=========================================================
    UTILITIES
=========================================================*/

.rounded-xl{

    border-radius:22px!important;

}

.shadow-soft{

    box-shadow:var(--shadow)!important;

}

.shadow-lg-soft{

    box-shadow:var(--shadow-lg)!important;

}

.bg-gradient-primary{

    background:linear-gradient(135deg,#2563eb,#4f46e5);

}

.bg-gradient-success{

    background:linear-gradient(135deg,#22c55e,#16a34a);

}

.bg-gradient-danger{

    background:linear-gradient(135deg,#ef4444,#dc2626);

}

.bg-gradient-warning{

    background:linear-gradient(135deg,#f59e0b,#ea580c);

}

.text-gradient{

    background:linear-gradient(135deg,#2563eb,#4f46e5);

    -webkit-background-clip:text;

    -webkit-text-fill-color:transparent;

}

/*=========================================================
    DARK MODE
=========================================================*/

body.dark-mode{

    background:#0f172a;

    color:#f1f5f9;

}

body.dark-mode .card,
body.dark-mode .table-container,
body.dark-mode .chart-card,
body.dark-mode .settings-card,
body.dark-mode .report-card,
body.dark-mode .profile-card,
body.dark-mode .search-card{

    background:#1e293b;

    color:#fff;

}

body.dark-mode .table thead th{

    background:#334155;

    color:#fff;

}

body.dark-mode .table tbody tr{

    background:#1e293b;

}

body.dark-mode .form-control,
body.dark-mode .form-select{

    background:#334155;

    color:#fff;

    border-color:#475569;

}

body.dark-mode label{

    color:#fff;

}

body.dark-mode p{

    color:#cbd5e1;

}

/*=========================================================
    RESPONSIVE
=========================================================*/

@media(max-width:1200px){

.main-content{

margin-left:0;

padding:25px;

}

.sidebar{

left:-280px;

transition:.4s;

}

.sidebar.active{

left:0;

}

}

@media(max-width:992px){

.stats-card h2{

font-size:30px;

}

.profile-stats{

flex-direction:column;

gap:20px;

}

.chart-card canvas{

height:300px!important;

}

}

@media(max-width:768px){

.main-content{

padding:18px;

}

.card-body{

padding:18px;

}

.table{

font-size:14px;

}

.btn{

width:100%;

margin-bottom:10px;

}

.search-box{

width:100%;

}

.footer{

text-align:center;

}

.footer-social{

justify-content:center;

margin-top:20px;

}

}

@media(max-width:576px){

.page-title{

font-size:24px;

}

.stats-card{

padding:20px;

}

.stats-card h2{

font-size:26px;

}

.profile-avatar{

width:90px;

height:90px;

}

}

/*=========================================================
    PRINT
=========================================================*/

@media print{

.sidebar,
.custom-navbar,
.footer,
.btn,
.pagination{

display:none!important;

}

.main-content{

margin:0;

padding:0;

}

.card{

box-shadow:none;

border:1px solid #ddd;

}

body{

background:#fff;

}

}

/*=========================================================
    ANIMATIONS
=========================================================*/

@keyframes float{

0%{

transform:translateY(0);

}

50%{

transform:translateY(-8px);

}

100%{

transform:translateY(0);

}

}

.float{

animation:float 4s ease-in-out infinite;

}

.fade-in{

animation:fadeIn .7s ease;

}

@keyframes fadeIn{

from{

opacity:0;

}

to{

opacity:1;

}

}

.slide-up{

animation:slideUp .6s ease;

}

@keyframes slideUp{

from{

opacity:0;

transform:translateY(25px);

}

to{

opacity:1;

transform:translateY(0);

}

}

/*=========================================================
    END OF FILE
=========================================================*/

/* ==========================================
   PROFILE PAGE MODERN UI
========================================== */


.profile-page{

    padding:25px;

    background:#f5f7fb;

    min-height:100vh;

}




/* PROFILE HEADER */

.profile-header{

    background:linear-gradient(
        135deg,
        #4f46e5,
        #9333ea
    );

    padding:40px;

    border-radius:25px;

    display:flex;

    align-items:center;

    gap:25px;

    color:white;

    box-shadow:
    0 20px 40px rgba(79,70,229,.25);

}



.profile-header h1{

    font-size:32px;

    font-weight:700;

    margin:0;

}



.profile-header p{

    margin-top:8px;

    opacity:.85;

    font-size:16px;

}




/* AVATAR */


.avatar{

    width:100px;

    height:100px;

    border-radius:50%;

    background:white;

    color:#4f46e5;

    display:flex;

    justify-content:center;

    align-items:center;

    font-size:45px;

    font-weight:800;

    box-shadow:

    0 10px 25px rgba(0,0,0,.2);

}






/* CARDS */


.modern-card{

    background:white;

    border-radius:22px;

    overflow:hidden;

    border:none;

    box-shadow:

    0 10px 30px rgba(0,0,0,.08);

    transition:.35s ease;

}



.modern-card:hover{

    transform:translateY(-7px);

    box-shadow:

    0 20px 45px rgba(0,0,0,.15);

}






/* CARD HEADER */


.card-title{

    padding:20px 25px;

    font-size:20px;

    font-weight:700;

    color:white;

    background:

    linear-gradient(
    135deg,
    #4f46e5,
    #6366f1
    );

}



.card-title.orange{

    background:

    linear-gradient(
    135deg,
    #f59e0b,
    #ea580c
    );

}



.card-title.blue{

    background:

    linear-gradient(
    135deg,
    #0891b2,
    #2563eb
    );

}





.card-body{

    padding:30px;

}






/* LABELS */


label{

    font-weight:600;

    color:#374151;

    display:block;

    margin-bottom:8px;

}




label i{

    color:#4f46e5;

    margin-right:6px;

}





/* INPUTS */


.form-control{

    height:48px;

    border-radius:14px;

    border:1px solid #e5e7eb;

    padding-left:15px;

    font-size:15px;

    transition:.3s;

}



.form-control:focus{

    border-color:#6366f1;

    box-shadow:

    0 0 0 4px rgba(99,102,241,.15);

}






/* BUTTONS */


.btn{

    border-radius:14px;

    height:48px;

    font-weight:700;

    transition:.3s;

}



.btn-primary{

    background:

    linear-gradient(
    135deg,
    #4f46e5,
    #7c3aed
    );

    border:none;

}



.btn-primary:hover{

    transform:scale(1.03);

}



.btn-warning{

    background:

    linear-gradient(
    135deg,
    #f59e0b,
    #f97316
    );

    color:white;

    border:none;

}



.btn-warning:hover{

    transform:scale(1.03);

    color:white;

}






/* STAT BOXES */


.stat{

    background:#f8fafc;

    border-radius:18px;

    padding:25px;

    text-align:center;

    height:100%;

    transition:.3s;

}



.stat:hover{

    background:#eef2ff;

    transform:translateY(-5px);

}



.stat i{

    font-size:35px;

    color:#4f46e5;

    margin-bottom:10px;

}



.stat h6{

    color:#6b7280;

    font-weight:600;

}



.stat h4,
.stat h5{

    color:#111827;

    font-weight:700;

}






/* SECURITY BOX */


.security-box{

    background:

    linear-gradient(
    135deg,
    #dbeafe,
    #ede9fe
    );


    border-radius:18px;

    padding:20px;

    color:#1e3a8a;

}



.security-box i{

    font-size:30px;

    margin-right:10px;

}



.security-box p{

    margin:

    10px 0 0 40px;

}






/* ALERT DESIGN */


.alert{

    border:none;

    border-radius:15px;

    padding:15px 20px;

    font-weight:600;

}






/* RESPONSIVE */


@media(max-width:768px){


.profile-header{

    flex-direction:column;

    text-align:center;

}


.profile-header h1{

    font-size:26px;

}



.avatar{

    width:80px;

    height:80px;

    font-size:35px;

}



.card-body{

    padding:20px;

}


}